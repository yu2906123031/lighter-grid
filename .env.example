# Lighter Phoenix Grid - environment template
# Copy to .env and fill in your values.

# === Connection ===
LIGHTER_BASE_URL=https://api.rh.lighter.xyz/
LIGHTER_ACCOUNT_INDEX=0
# API key index: 0-1 are reserved for the web/mobile UI; use 2-254 for the bot
LIGHTER_API_KEY_INDEX=4
# API key private key (pick one):
#   (a) plaintext (not recommended for production)
LIGHTER_API_PRIVATE_KEY=your_private_key_here
#   (b) encrypted .enc file (recommended)
# LIGHTER_API_KEY_ENC=secrets/api-key.enc

# === Target ===
LIGHTER_MARKET=5
LIGHTER_SYMBOL=LIT

# === Grid params ===
GRID_COUNT=9
GRID_SPACING_PCT=0.5
LEVERAGE=5
MARGIN_FRAC=0.8
MAX_INVENTORY=3
STOP_LOSS_PCT=0
MAX_SPREAD_PCT=0.5

# === Run ===
MODE=dryrun
TICK_MS=10
STATE_FILE=data/state.json
LOG_LEVEL=INFO
