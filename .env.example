# Lighter Phoenix Grid — 环境配置示例
# 复制为 .env 并填写。生产环境私钥用 .enc 加密文件（见 README）。

# === 连接 ===
LIGHTER_BASE_URL=https://api.rh.lighter.xyz/
# 账户 index（Lighter 整数标识，用 accountsByL1Address 查询）
LIGHTER_ACCOUNT_INDEX=0
# API key index（0-3 保留给官方 UI，自己用 4 起）
LIGHTER_API_KEY_INDEX=4
# API key 私钥：二选一
#   (a) 明文（不推荐，仅测试用）
LIGHTER_API_PRIVATE_KEY=
#   (b) .enc 加密文件（推荐，配合 GRID_PASSPHRASE）
LIGHTER_API_KEY_ENC=secrets/api-key.enc

# === 标的 ===
# LIT perp = market_index 5
LIGHTER_MARKET=5
LIGHTER_SYMBOL=LIT

# === 网格参数 ===
# 网格档数（总，上下对称，奇数）
GRID_COUNT=9
# 每档间距（百分比，0.5 = 0.5%）
GRID_SPACING_PCT=0.5
# 杠杆（LIT 最大 5x）
LEVERAGE=5
# 保证金分数：用于网格的 equity 比例（0-1）
MARGIN_FRAC=0.8
# 止损 backstop：价格反向超过 mid 的百分比触发止损（0 = 关闭）
STOP_LOSS_PCT=0
# 价差闸：spread 超过该百分比时只减仓不挂新单
MAX_SPREAD_PCT=0.5

# === 运行 ===
# 运行模式：live / dryrun
MODE=dryrun
# tick 间隔（秒）
TICK_MS=10
# 状态文件
STATE_FILE=data/state.json
# 日志级别
LOG_LEVEL=INFO
